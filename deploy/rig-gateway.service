# llm-gateway on the GPU rig. Always on: it is only a listener and loads nothing until a
# request names a profile (then it runs `rig start remote <id>`). Loopback only; clients use
# the SSH tunnel (desktop rig-llm forwards 8080).
[Unit]
Description=llm-gateway (OpenAI API -> rig remote profiles, on demand)
After=network-online.target remote-fs.target rig-boot.service
Wants=network-online.target remote-fs.target

[Service]
Type=simple
User=bryan
Group=bryan
WorkingDirectory=/home/bryan/llm-gateway
Environment=PYTHONPATH=/home/bryan/llm-gateway/src
Environment=RIG_COMMAND=/usr/local/bin/rig
Environment=PROFILES_PATH=/home/bryan/llm-gateway/remote_profiles.json
Environment=UPSTREAM_HOST=127.0.0.1
Environment=MODEL_PREFIX=gpu-rig
Environment=GATEWAY_BIND=127.0.0.1
Environment=GATEWAY_PORT=8080
Environment=START_TIMEOUT_SECONDS=900
Environment=REQUEST_TIMEOUT_SECONDS=900
ExecStart=/home/bryan/llm-gateway/.venv/bin/python -m llm_gateway
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
