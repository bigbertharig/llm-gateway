# llm-gateway on the Pi: the one front door for the rig's models. Always on: it is only a
# listener and loads nothing until a request names a profile (then it runs `rig start remote
# <id>` on the rig over ssh). Upstream ports come through pi-rig-tunnel.service.
# Loopback only unless GATEWAY_API_KEYS_FILE has keys (the gateway refuses a LAN bind without them).
# Installed by deploy/deploy_pi.sh.
[Unit]
Description=llm-gateway (OpenAI API -> rig remote profiles, on demand)
After=network-online.target pi-rig-tunnel.service
Wants=network-online.target pi-rig-tunnel.service

[Service]
Type=simple
User=bryan
Group=bryan
WorkingDirectory=/home/bryan/llm-gateway
Environment=PYTHONPATH=/home/bryan/llm-gateway/src
# One multiplexed ssh connection for rig calls (about 125 ms per `rig status` instead of 500 ms).
Environment="RIG_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o ControlMaster=auto -o ControlPath=/home/bryan/.ssh/cm-llm-gateway-%%C -o ControlPersist=10m bryan@10.0.0.3 /usr/local/bin/rig"
Environment=PROFILES_PATH=/home/bryan/llm-gateway/remote_profiles.json
Environment=UPSTREAM_HOST=127.0.0.1
Environment=MODEL_PREFIX=gpu-rig
Environment=GATEWAY_BIND=127.0.0.1
Environment=GATEWAY_PORT=8080
Environment=GATEWAY_API_KEYS_FILE=/etc/llm-gateway/api_keys
# Rig manager (docs/MANAGER.md): lease store and claims on the shared drive (local disk on the Pi).
Environment=MANAGER_SHARED_PATH=/media/bryan/shared
Environment=START_TIMEOUT_SECONDS=900
Environment=REQUEST_TIMEOUT_SECONDS=900
ExecStart=/home/bryan/llm-gateway/.venv/bin/python -m llm_gateway
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
