# Token presented by VS Code to this gateway.
GATEWAY_API_KEY=replace-with-a-long-random-token

# OpenRouter is optional until cloud models are configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CLOUD_SETTINGS_ROOT=/home/bryan/.config/llm-gateway/cloud

# Maximum newline-delimited Codex app-server protocol message (clamped to 8-128 MiB).
CODEX_APP_SERVER_LINE_LIMIT_MIB=64

# Pi-side control API. Keep this listener on localhost.
ORCHESTRATOR_URL=http://127.0.0.1:8790
ORCHESTRATOR_API_KEY=replace-with-a-different-long-random-token

REQUEST_TIMEOUT_SECONDS=600
LOCAL_SESSION_TTL_SECONDS=900
LOCAL_SESSION_RENEW_SECONDS=60
