# Token presented by VS Code to this gateway.
GATEWAY_API_KEY=replace-with-a-long-random-token

# OpenRouter is optional until cloud models are configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Rig-side control API, reachable from the Pi over the home LAN.
ORCHESTRATOR_URL=http://10.0.0.3:8790
ORCHESTRATOR_API_KEY=replace-with-a-different-long-random-token

REQUEST_TIMEOUT_SECONDS=600
LOCAL_SESSION_TTL_SECONDS=900
LOCAL_SESSION_RENEW_SECONDS=60

